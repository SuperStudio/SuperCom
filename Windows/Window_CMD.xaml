<super:BaseWindow
    x:Class="SuperCom.Windows.Window_CMD"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:super="https://github.com/SuperStudio/SuperControls"
    Title="CMD 指令工具"
    Width="1000"
    Height="700"
    MinWidth="700"
    MinHeight="500"
    Background="{DynamicResource Window.Background}"
    Foreground="{DynamicResource Window.Foreground}"
    Icon="pack://application:,,,/Resources/Ico/ICON.ico"
    WindowStartupLocation="CenterScreen"
    Closing="BaseWindow_Closing"
    Loaded="BaseWindow_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：进程控制 + 快捷执行 -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource TabItem.Background}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 进程控制 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Style="{StaticResource BaseTextBlock}"
                        Text="CMD 进程：" />
                    <Button
                        Name="BtnStart"
                        MinWidth="70"
                        Margin="5,0"
                        Click="BtnStart_Click"
                        Content="启动"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Name="BtnStop"
                        MinWidth="70"
                        Margin="5,0"
                        Click="BtnStop_Click"
                        Content="停止"
                        IsEnabled="False"
                        Style="{StaticResource ButtonDanger}" />
                    <Separator Margin="10,0" />
                    <TextBlock
                        Name="TxtStatus"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="Gray"
                        Style="{StaticResource BaseTextBlock}"
                        Text="未启动" />
                </StackPanel>

                <!-- 间隔设置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlock}"
                        Text="间隔：" />
                    <TextBox
                        Name="TxtDefaultDelay"
                        MinWidth="60"
                        Margin="5,0"
                        Padding="8,5"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        TextChanged="TxtDefaultDelay_TextChanged"
                        Style="{StaticResource BaseTextBox}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlock}"
                        Text="ms" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：指令列表 -->
            <Border
                Grid.Column="0"
                Padding="10"
                Background="{DynamicResource TabItem.Background}"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Name="ChkSelectAll"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Click="ChkSelectAll_Click"
                            Style="{StaticResource NormalCheckBox}"
                            ToolTip="全选/取消全选" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Style="{StaticResource BaseTextBlock}"
                            Text="指令列表" />
                        <Button
                            Grid.Column="2"
                            MinWidth="60"
                            Click="BtnDeleteSelected_Click"
                            Content="删除"
                            FontSize="11"
                            Style="{StaticResource ButtonDanger}" />
                    </Grid>

                    <!-- 添加指令 -->
                    <Grid Grid.Row="1" Margin="0,5,0,10" Width="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Name="TxtNewCommand"
                            Margin="0,0,5,0"
                            MinWidth="200"
                            Padding="8,5"
                            BorderBrush="#607080"
                            BorderThickness="1"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            KeyDown="TxtNewCommand_KeyDown"
                            Style="{StaticResource BaseTextBox}" />
                        <Button
                            Grid.Column="1"
                            MinWidth="50"
                            Click="BtnAddCommand_Click"
                            Content="添加"
                            Style="{StaticResource ButtonPrimary}" />
                    </Grid>

                    <!-- 指令列表 -->
                    <DataGrid
                        Grid.Row="2"
                        Name="DataGridCommands"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        Background="{DynamicResource TabItem.Background}"
                        RowBackground="{DynamicResource TabItem.Background}"
                        AlternatingRowBackground="{DynamicResource TabItem.Background}"
                        BorderBrush="{DynamicResource TabItem.Background}"
                        GridLinesVisibility="Horizontal">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource TabItem.Background}" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#30507080" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NormalCheckBox}"
                                            VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="指令" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="5,2"
                                            Style="{StaticResource BaseTextBlock}"
                                            Text="{Binding Command}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Command}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="时延" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource BaseTextBlock}"
                                            Text="{Binding Delay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部按钮 -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="80"
                            Click="BtnExecuteSelected_Click"
                            Content="发送选中"
                            Style="{StaticResource ButtonPrimary}" />
                        <CheckBox
                            Name="ChkLoop"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Content="循环"
                            Click="ChkLoop_Click"
                            Style="{StaticResource NormalCheckBox}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分割条 -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Style="{StaticResource HoverSpliter}" />

            <!-- 右侧：输出区 -->
            <Border Grid.Column="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 输出区表头 -->
                    <Border
                        Grid.Row="0"
                        Padding="10"
                        Background="{DynamicResource TabItem.Background}"
                        CornerRadius="5,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlock}"
                                Text="输出" />
                            <Button
                                Grid.Column="1"
                                MinWidth="60"
                                Margin="5,0"
                                Click="BtnClearOutput_Click"
                                Content="清空"
                                FontSize="11"
                                Style="{StaticResource ButtonPrimary}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="60"
                                Click="BtnSaveOutput_Click"
                                Content="保存"
                                FontSize="11"
                                Style="{StaticResource ButtonPrimary}" />
                        </Grid>
                    </Border>

                    <!-- 输出内容 -->
                    <Border
                        Grid.Row="1"
                        Padding="5"
                        Background="{DynamicResource TabItem.Background}"
                        CornerRadius="0">
                        <TextBox
                            Name="TxtOutput"
                            Padding="10"
                            Background="{DynamicResource TabItem.Background}"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{DynamicResource Window.Foreground}"
                            TextWrapping="Wrap"
                            IsReadOnly="False"
                            IsReadOnlyCaretVisible="False"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            BorderThickness="0"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            PreviewKeyDown="TxtOutput_PreviewKeyDown"
                            PreviewKeyUp="TxtOutput_PreviewKeyUp"
                            SelectionChanged="TxtOutput_SelectionChanged"
                            TextChanged="TxtOutput_TextChanged" />
                    </Border>

                    <!-- 输入指令区 -->
                    <Border
                        Grid.Row="2"
                        Padding="8"
                        Background="{DynamicResource TabItem.Background}"
                        BorderBrush="#607080"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0">
                        <Grid Width="Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- TxtExecuteCommand 作为辅助输入（备选，提示符交互在 TxtOutput 内完成） -->
                            <TextBox
                                Grid.Column="0"
                                Name="TxtExecuteCommand"
                                Margin="0,0,5,0"
                                MinWidth="300"
                                Padding="8,6"
                                BorderBrush="#607080"
                                BorderThickness="1"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                KeyDown="TxtExecuteCommand_KeyDown"
                            PreviewKeyDown="TxtExecuteCommand_PreviewKeyDown"
                                Style="{StaticResource BaseTextBox}" />
                            <Button
                                Grid.Column="1"
                                MinWidth="70"
                                Click="BtnExecuteCommand_Click"
                                Content="发送"
                                Style="{StaticResource ButtonPrimary}" />
                        </Grid>
                    </Border>

                    <!-- 状态栏 -->
                    <Border
                        Grid.Row="3"
                        Padding="10,5"
                        Background="{DynamicResource TabItem.Background}"
                        CornerRadius="0,0,5,5">
                        <TextBlock
                            Name="TxtStatusBar"
                            Style="{StaticResource BaseTextBlock}"
                            Text="就绪" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</super:BaseWindow>
